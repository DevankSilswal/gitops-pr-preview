# Copy to terraform.tfvars and fill in from the OCI console.
# terraform.tfvars is gitignored — it points at your private API key.

tenancy_ocid     = "ocid1.tenancy.oc1..xxxxx"
user_ocid        = "ocid1.user.oc1..xxxxx"
fingerprint      = "aa:bb:cc:dd:..."
private_key_path = "~/.oci/oci_api_key.pem"
region           = "ap-mumbai-1"

# ssh-keygen -t ed25519 -f ~/.ssh/oci -N ""  then paste ~/.ssh/oci.pub here
ssh_public_key = "ssh-ed25519 AAAA... you@example.com"
